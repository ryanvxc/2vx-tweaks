{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: system information, logging, custom window chrome, the local account, the tweak engine (IDs only: plan, apply, revert, history), PC Cleaner actions (IDs only: clear allowlisted locations, switch startup entries, remove or restore listed apps), opening fixed links and Windows tools (an entry name, never an address or a command), saving the system report (text only, to a file the user picks), a user-started ping of two fixed targets, the sign-in Run entry, and the signed updater (check, download, install, relaunch).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "updater:default",
    "process:allow-restart",
    "allow-get-app-info",
    "allow-log-frontend-event",
    "allow-get-update-support",
    "allow-get-account",
    "allow-set-account",
    "allow-clear-account",
    "allow-get-system-snapshot",
    "allow-get-device-report",
    "allow-get-hardware-details",
    "allow-get-service-states",
    "allow-ping-target",
    "allow-export-report",
    "allow-measure-sleep",
    "allow-open-link",
    "allow-open-tool",
    "allow-open-log-folder",
    "allow-get-metrics",
    "allow-get-running-programs",
    "allow-list-startup-items",
    "allow-scan-cleanup-locations",
    "allow-clean-locations",
    "allow-get-auto-launch",
    "allow-set-auto-launch",
    "allow-set-startup-enabled",
    "allow-list-removable-apps",
    "allow-uninstall-app",
    "allow-reinstall-app",
    "allow-list-tweaks",
    "allow-list-retired-tweaks",
    "allow-get-engine-status",
    "allow-get-tweak-statuses",
    "allow-plan-tweaks",
    "allow-apply-plan",
    "allow-revert-snapshot",
    "allow-revert-tweak",
    "allow-revert-tweaks",
    "allow-list-snapshots",
    "allow-get-snapshot-changes"
  ]
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: system information, logging, custom window chrome, and the tweak engine (IDs only: plan, apply, revert, history).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "allow-get-app-info",
    "allow-log-frontend-event",
    "allow-get-system-snapshot",
    "allow-get-metrics",
    "allow-list-tweaks",
    "allow-get-engine-status",
    "allow-get-tweak-statuses",
    "allow-plan-tweaks",
    "allow-apply-plan",
    "allow-revert-snapshot",
    "allow-list-snapshots",
    "allow-get-snapshot-changes"
  ]
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "2VX Tweaks",
  "version": "0.2.0",
  "identifier": "com.twovx.tweaks",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "2VX Tweaks",
        "width": 1320,
        "height": 840,
        "minWidth": 1080,
        "minHeight": 700,
        "center": true,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "backgroundColor": "#0d0d11"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczOEIxODRDRUVBODczNjAKUldSZ2M2anVUQmlMYzhHSGttLzhGL0xFbFkyM2h0K1NwRUxnbVZKdE9BMFFKUlcrdHIyMStrcmQK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
